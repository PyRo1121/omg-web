# Wrangler-generated declarations preserve upstream whitespace verbatim.
workers/api/worker-configuration.d.ts whitespace=-blank-at-eol

# Release installers are byte-for-byte mirrors; preserve their intentional banner spacing.
site/static/install.ps1 whitespace=-blank-at-eol
site/static/install.sh whitespace=-blank-at-eol

# Preserve canonical bytes for installer parity and immutable migration hashes.
*.sh text eol=lf
*.sql text eol=lf
*.sha256 text eol=lf
site/static/install.ps1 text eol=lf
site/static/.well-known/omg-license-ed25519-v1.pem text eol=lf
# Match Prettier's LF policy on Windows as well as CI. Binary assets are auto-detected.
* text=auto eol=lf
