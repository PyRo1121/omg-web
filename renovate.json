{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "rangeStrategy": "pin",
  "dependencyDashboard": true,
  "schedule": ["before 6am on the first day of the week"],
  "timezone": "UTC",
  "separateMajorMinor": true,
  "lockFileMaintenance": {
    "enabled": true
  },
  "minimumReleaseAge": "5 days",
  "packageRules": [
    {
      "description": "Keep the supported Node range aligned with CI instead of pinning one release",
      "matchDepTypes": ["engines"],
      "enabled": false
    },
    {
      "description": "Batch non-major dependency updates into a single weekly PR",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "lockFileMaintenance"],
      "groupName": "non-major dependencies",
      "automerge": false
    },
    {
      "description": "Review prerelease SvelteKit and its Alchemy adapter together without blocking unrelated security updates",
      "matchPackageNames": ["@sveltejs/kit", "@alchemy.run/frontend-frameworks", "alchemy"],
      "groupName": "SvelteKit adapter compatibility",
      "automerge": false
    }
  ]
}
