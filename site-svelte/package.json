{
  "name": "omg-site-svelte",
  "version": "0.1.0",
  "private": true,
  "description": "Alchemy-managed SvelteKit migration target for OMG",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "audit": "npm audit",
    "build": "vite build",
    "check": "npm run sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc --noEmit",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "dev": "alchemy dev",
    "plan": "alchemy plan",
    "preview": "vite preview",
    "sync": "svelte-kit sync",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "better-auth": "1.7.1",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.74",
    "@effect/platform-node": "4.0.0-rc.112",
    "@sveltejs/kit": "3.0.0-next.9",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@types/node": "24.13.3",
    "alchemy": "2.0.0-beta.74",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.8",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@hono/node-server": "1.19.17",
    "better-auth": {
      "@sveltejs/kit": "3.0.0-next.9"
    },
    "hono": "4.13.4",
    "lodash": "4.18.1",
    "valibot": "1.4.2"
  },
  "allowScripts": {
    "esbuild": true,
    "msgpackr-extract@3.0.4": false,
    "workerd@1.20260704.1": true
  }
}
