# Applies to STATIC ASSET responses only. SSR/API responses (/dashboard, /admin,
# /api/*) are produced by the Worker script and bypass this file entirely; their
# headers are owned by the Worker code.
#
# Cache-Control is intentionally NOT set on the `/*` rule: this file is concatenated
# with Nitro's generated rules (writeCFHeaders in nitropack's Cloudflare preset), and
# Cloudflare concatenates duplicate header names across matching rules. A blanket
# `max-age=0` here previously produced `max-age=0, ... immutable, max-age=31536000`
# on hashed assets. Nitro's generated rules already cover prerendered HTML
# (max-age=0) and /_build/assets/* (immutable); the explicit rules below cover the
# remaining static files.
#
# CSP notes: prepare-worker-assets appends path-specific SHA-256 policies for
# prerendered HTML, while dynamic SolidStart HTML receives a request-local nonce.
# A global CSP is intentionally absent because multiple CSP headers intersect and
# would block the generated hashes. Never reintroduce script unsafe-inline/eval.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Vary: Accept-Encoding

/og/*
  Cache-Control: public, max-age=31536000, immutable

# Prerendered HTML must always revalidate (Nitro's generated rules cover
# /_build/assets/* but not the directory-index URLs below).
/
  Cache-Control: public, max-age=0, must-revalidate

/login/
  Cache-Control: public, max-age=0, must-revalidate

/signup/
  Cache-Control: public, max-age=0, must-revalidate

/docs/
  Cache-Control: public, max-age=0, must-revalidate

/privacy/
  Cache-Control: public, max-age=0, must-revalidate

/terms/
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable
  Vary: Accept-Encoding

/.well-known/omg-license-ed25519-v1.pem
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/x-pem-file
  Vary: Accept-Encoding

/install.sh
  Cache-Control: public, max-age=3600

/install.ps1
  Cache-Control: public, max-age=3600

/favicon.svg
  Cache-Control: public, max-age=86400

/favicon.png
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400

/manifest.json
  Cache-Control: public, max-age=86400

/site.webmanifest
  Cache-Control: public, max-age=86400
