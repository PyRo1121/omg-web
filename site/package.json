{
  "name": "omg-site",
  "version": "1.0.0",
  "description": "OMG Package Manager - Marketing Site",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "audit": "npm audit",
    "build": "npm run build:site",
    "build:check": "npm run build:site && npm run check:bundle-budget",
    "build:site": "vinxi build && node tools/prepare-worker-assets.mjs",
    "check:bundle-budget": "node tools/check-bundle-budget.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "check:fix": "npm run lint:fix && npm run format",
    "dev": "vinxi dev",
    "format": "npm --prefix .. run format",
    "format:check": "npm --prefix .. run format:check",
    "lint": "npm --prefix .. run lint:site",
    "lint:fix": "npm --prefix .. run lint:site:fix",
    "preview": "wrangler dev --config wrangler.toml --port 3000",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:anonymous": "playwright test e2e/anonymous.spec.ts",
    "test:e2e:staging": "playwright test e2e/staging-auth.spec.ts",
    "test:watch": "vitest",
    "typecheck": "node tools/prepare-worker-assets.mjs --clean && wrangler types worker-configuration.d.ts --include-runtime=false --check && tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@kobalte/core": "0.13.13",
    "@sentry/solid": "10.70.0",
    "@solid-primitives/keyboard": "1.3.7",
    "@solid-primitives/scheduled": "1.5.3",
    "@solidjs/meta": "0.29.4",
    "@solidjs/router": "0.16.3",
    "@solidjs/start": "1.3.2",
    "@tanstack/solid-query": "5.101.4",
    "@tanstack/solid-table": "9.1.2",
    "@tanstack/table-core": "9.1.2",
    "better-auth": "1.7.1",
    "clsx": "2.1.1",
    "cmdk-solid": "1.1.2",
    "drizzle-orm": "0.45.2",
    "effect": "3.22.1",
    "lucide-solid": "1.33.0",
    "shiki": "4.4.3",
    "simple-icons": "16.28.0",
    "solid-js": "1.9.15",
    "tailwind-merge": "3.6.0",
    "vinxi": "0.5.11"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "autoprefixer": "10.5.4",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "6.4.3",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  },
  "overrides": {
    "dax-sh": "npm:dax@0.44.2",
    "follow-redirects": "1.16.0",
    "h3": "1.15.11",
    "minimatch": "10.2.4",
    "nitropack": "2.13.4",
    "node-forge": "1.4.0",
    "picomatch@2.3.0 - 2.3.1": "2.3.2",
    "picomatch@4.0.0 - 4.0.3": "4.0.5",
    "serialize-javascript": "7.1.0",
    "tar": "7.5.22"
  },
  "allowScripts": {
    "@parcel/watcher@2.5.6": true,
    "esbuild": true,
    "workerd@1.20260820.1": true
  }
}
