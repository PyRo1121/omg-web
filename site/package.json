{
  "name": "omg-site",
  "version": "0.1.0",
  "private": true,
  "description": "Alchemy-managed SvelteKit website for OMG",
  "type": "module",
  "packageManager": "npm@12.0.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "audit": "npm audit",
    "build": "vite build",
    "build:check": "npm run build && npm run check:bundle-budget",
    "check": "npm run check:docs && npm run sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc --noEmit && npm run typecheck:e2e",
    "check:bundle-budget": "node tools/check-bundle-budget.mjs",
    "check:docs": "node tools/check-docs-freshness.mjs",
    "deploy": "node alchemy.environment.mjs deploy",
    "destroy": "node alchemy.environment.mjs destroy",
    "dev": "node alchemy.environment.mjs dev",
    "dev:e2e": "vite dev --host 127.0.0.1 --port 4173",
    "plan": "node alchemy.environment.mjs plan",
    "preview": "vite preview",
    "sync": "svelte-kit sync",
    "test": "vitest run --exclude 'e2e/**'",
    "test:e2e": "playwright test",
    "test:e2e:external": "playwright test",
    "test:e2e:public": "playwright test e2e/anonymous.spec.ts",
    "typecheck:e2e": "tsc --project e2e/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "better-auth": "1.7.1",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@alchemy.run/frontend-frameworks": "2.0.0-beta.74",
    "@effect/platform-node": "4.0.0-rc.112",
    "@playwright/test": "1.62.1",
    "@sveltejs/kit": "3.0.0-next.9",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@types/node": "24.13.3",
    "alchemy": "2.0.0-beta.74",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.8",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  },
  "overrides": {
    "@hono/node-server": "1.19.17",
    "better-auth": {
      "@sveltejs/kit": "3.0.0-next.9"
    },
    "hono": "4.13.4",
    "lodash": "4.18.1",
    "valibot": "1.4.2"
  },
  "allowScripts": {
    "msgpackr-extract@3.0.4": false,
    "esbuild@0.28.2": true,
    "workerd@1.20260704.1": true,
    "fsevents@2.3.2": false,
    "fsevents@2.3.3": false
  }
}
