{
  "name": "omg-saas-workers",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check:migrations": "node tools/check-migrations.mjs",
    "db:create": "wrangler d1 create omg-licensing",
    "db:migrate:local": "wrangler d1 migrations apply omg-licensing --local",
    "db:migrate:remote": "wrangler d1 migrations apply omg-licensing --remote",
    "types": "wrangler types worker-configuration.d.ts",
    "lint": "npm --prefix ../.. run lint:workers",
    "lint:fix": "npm --prefix ../.. run lint:workers:fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "wrangler types worker-configuration.d.ts --check && tsc --noEmit",
    "check": "npm run check:migrations && npm run typecheck && npm run lint && npm run format:check && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "prettier": "3.8.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wrangler": "4.123.0"
  },
  "dependencies": {
    "@effect/schema": "0.75.5",
    "@sentry/cloudflare": "10.70.0",
    "effect": "3.22.1"
  },
  "type": "module"
}
