{
  "name": "omg-saas-workers",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check:migrations": "node tools/check-migrations.mjs",
    "db:create": "wrangler d1 create omg-platform",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "types": "wrangler types worker-configuration.d.ts",
    "lint": "npm --prefix ../.. run lint:workers",
    "lint:fix": "npm --prefix ../.. run lint:workers:fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "typecheck": "wrangler types worker-configuration.d.ts --check && tsc --noEmit",
    "check": "npm run check:migrations && npm run typecheck && npm run lint && npm run format:check && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.0.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.125.0"
  },
  "dependencies": {
    "@sentry/cloudflare": "10.70.0",
    "effect": "3.22.1"
  },
  "type": "module",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260820.1": true
  }
}
